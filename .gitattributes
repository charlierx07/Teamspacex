# Normalise line endings to LF in the repository (cross-platform safety)
* text=auto eol=lf

# Force binary files to be treated as binary
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.svg binary
*.woff binary
*.woff2 binary
*.ttf binary
*.eot binary
*.otf binary
*.zip binary
*.gz binary
*.p12 binary
*.pfx binary
