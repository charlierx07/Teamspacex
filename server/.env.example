# ==============================================================================
# TeamspaceX Backend Environment Configuration Template
# COPY THIS FILE TO .env AND FILL IN YOUR OWN VALUES
# NEVER COMMIT THE ACTUAL .env FILE CONTAINING REAL SECRETS TO GIT
# ==============================================================================

# Server Network Configuration
PORT=5000
NODE_ENV=development
CLIENT_URL=http://localhost:3000

# ------------------------------------------------------------------------------
# Database Configuration
# ------------------------------------------------------------------------------
# MongoDB connection string (MongoDB Atlas cluster or local MongoDB instance).
# IMPORTANT: Never commit raw credentials.
# In development, you may set MONGODB_URI=memory for temporary in-memory storage.
MONGODB_URI=mongodb+srv://<db_username>:<db_password>@<cluster_name>.mongodb.net/<database_name>?retryWrites=true&w=majority

# ------------------------------------------------------------------------------
# Authentication & JWT Security (SERVER-SIDE ONLY - NEVER EXPOSE TO CLIENT)
# ------------------------------------------------------------------------------
# Generate a cryptographically strong random string (minimum 32 characters).
# Example to generate: openssl rand -base64 32
JWT_SECRET=your-cryptographically-secure-jwt-secret-min-32-chars
JWT_EXPIRES_IN=7d

# ------------------------------------------------------------------------------
# Initial Founder / Admin Account Bootstrap
# ------------------------------------------------------------------------------
# Used only when bootstrapping the first admin user on an empty database.
ADMIN_NAME=Admin User
ADMIN_EMAIL=admin@yourdomain.com
ADMIN_PASSWORD=ReplaceWithStrongPassword123!

# ------------------------------------------------------------------------------
# Database Seeding Default Password
# ------------------------------------------------------------------------------
# Password assigned to sample members when running 'npm run seed'.
DEFAULT_MEMBER_PASSWORD=ReplaceWithSampleMemberPassword123!

# ------------------------------------------------------------------------------
# Third-Party Integrations (If added in future)
# ------------------------------------------------------------------------------
# NOTE: All secret keys, private keys, and API tokens MUST remain server-side only.
# - Stripe Secret Key: STRIPE_SECRET_KEY=sk_test_... (Server-only)
# - Supabase Service Role Key: SUPABASE_SERVICE_ROLE_KEY=... (Server-only, NEVER client)
# - OpenAI / AWS / Twilio / SendGrid keys: Server-only
