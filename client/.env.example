# ==============================================================================
# TeamspaceX Frontend Environment Configuration Template
# COPY THIS FILE TO .env.local AND FILL IN YOUR OWN VALUES
# ==============================================================================

# ------------------------------------------------------------------------------
# Public API & Socket Endpoints (CLIENT-SAFE ONLY)
# ------------------------------------------------------------------------------
# NOTE: Next.js automatically bundles any environment variable prefixed with
# NEXT_PUBLIC_ into the browser JavaScript bundle visible to all visitors.
# 
# RULES FOR NEXT_PUBLIC_:
# 1. ONLY public-safe values belong here (e.g. backend host URL, public CDN URL).
# 2. NEVER put database URIs (MongoDB, PostgreSQL), JWT secrets, Stripe secret keys,
#    or Supabase service role keys under a NEXT_PUBLIC_ variable.
# 3. If using Supabase in the future, only NEXT_PUBLIC_SUPABASE_ANON_KEY may go here
#    and ONLY when Row Level Security (RLS) is strictly enabled on every table.
# 4. If using Stripe in the future, only NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY goes here.
# ------------------------------------------------------------------------------

NEXT_PUBLIC_API_URL=http://localhost:5000
NEXT_PUBLIC_SOCKET_URL=http://localhost:5000
