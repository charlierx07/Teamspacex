# ==============================================================================
# TeamspaceX Full-Stack Environment Configuration Template
# COPY THIS FILE TO server/.env AND client/.env.local RESPECTIVELY
# ==============================================================================

# ------------------------------------------------------------------------------
# BACKEND (server/.env) - SERVER-SIDE ONLY - NEVER EXPOSE TO CLIENT
# ------------------------------------------------------------------------------
PORT=5000
NODE_ENV=development
CLIENT_URL=http://localhost:3000

# MongoDB connection string (MongoDB Atlas cluster or local MongoDB)
MONGODB_URI=mongodb+srv://<db_username>:<db_password>@<cluster_name>.mongodb.net/<database_name>?retryWrites=true&w=majority

# JWT Signing Secret (Minimum 32 random characters - e.g. openssl rand -base64 32)
JWT_SECRET=your-cryptographically-secure-jwt-secret-min-32-chars
JWT_EXPIRES_IN=7d

# Initial Admin Bootstrap Credentials (Used only on initial database setup)
ADMIN_NAME=Admin User
ADMIN_EMAIL=admin@yourdomain.com
ADMIN_PASSWORD=ReplaceWithStrongPassword123!

# Default password for sample seeded accounts (npm run seed)
DEFAULT_MEMBER_PASSWORD=ReplaceWithSampleMemberPassword123!

# ------------------------------------------------------------------------------
# FRONTEND (client/.env.local) - CLIENT-SAFE ONLY
# ------------------------------------------------------------------------------
# WARNING: Variables with NEXT_PUBLIC_ are bundled into client-side JS.
# Never expose secrets, service role keys, or database credentials here.
NEXT_PUBLIC_API_URL=http://localhost:5000
NEXT_PUBLIC_SOCKET_URL=http://localhost:5000
